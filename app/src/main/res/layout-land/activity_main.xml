<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">

    <!-- Divide the available width into four equal columns. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnQuarter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnHalf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnThreeQuarters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.75" />

    <!-- The banner occupies the upper half of the content area. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bannerBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/iconRowTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.54" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/iconRowBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.87" />

    <!-- Green background beneath the banner. -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/green"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bannerBottom"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Banner photograph. -->
    <ImageView
        android:id="@+id/bannerImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_main_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bannerBottom" />

    <!-- Darken the photograph to improve text readability. -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/banner_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@id/bannerImage"
        app:layout_constraintEnd_toEndOf="@id/bannerImage"
        app:layout_constraintTop_toTopOf="@id/bannerImage"
        app:layout_constraintBottom_toBottomOf="@id/bannerImage" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="@string/welcome_message"
        android:textColor="@color/white"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="@id/bannerImage"
        app:layout_constraintEnd_toEndOf="@id/bannerImage"
        app:layout_constraintTop_toTopOf="@id/bannerImage"
        app:layout_constraintBottom_toBottomOf="@id/bannerImage" />

    <!-- Column 1: Facilities. -->
    <ImageButton
        android:id="@+id/btnFacilities"
        style="@style/CampusTopicImage"
        android:contentDescription="@string/facilities"
        android:src="@drawable/img_btn_facilities"
        android:onClick="onFacilitiesClick"
        app:layout_constraintWidth_percent="0.21"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/columnQuarter"
        app:layout_constraintTop_toTopOf="@id/iconRowTop"
        app:layout_constraintBottom_toTopOf="@id/iconRowBottom" />

    <TextView
        style="@style/CampusTopicCaption"
        android:layout_height="wrap_content"
        android:text="@string/facilities"
        app:layout_constraintStart_toStartOf="@id/btnFacilities"
        app:layout_constraintEnd_toEndOf="@id/btnFacilities"
        app:layout_constraintTop_toBottomOf="@id/btnFacilities"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Column 2: Events. -->
    <ImageButton
        android:id="@+id/btnEvents"
        style="@style/CampusTopicImage"
        android:contentDescription="@string/events"
        android:src="@drawable/img_btn_events"
        android:onClick="onEventsClick"
        app:layout_constraintWidth_percent="0.21"
        app:layout_constraintStart_toStartOf="@id/columnQuarter"
        app:layout_constraintEnd_toStartOf="@id/columnHalf"
        app:layout_constraintTop_toTopOf="@id/iconRowTop"
        app:layout_constraintBottom_toTopOf="@id/iconRowBottom" />

    <TextView
        style="@style/CampusTopicCaption"
        android:layout_height="wrap_content"
        android:text="@string/events"
        app:layout_constraintStart_toStartOf="@id/btnEvents"
        app:layout_constraintEnd_toEndOf="@id/btnEvents"
        app:layout_constraintTop_toBottomOf="@id/btnEvents"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Column 3: Clubs. -->
    <ImageButton
        android:id="@+id/btnClubs"
        style="@style/CampusTopicImage"
        android:contentDescription="@string/clubs"
        android:src="@drawable/img_btn_clubs"
        android:onClick="onClubsClick"
        app:layout_constraintWidth_percent="0.21"
        app:layout_constraintStart_toStartOf="@id/columnHalf"
        app:layout_constraintEnd_toStartOf="@id/columnThreeQuarters"
        app:layout_constraintTop_toTopOf="@id/iconRowTop"
        app:layout_constraintBottom_toTopOf="@id/iconRowBottom" />

    <TextView
        style="@style/CampusTopicCaption"
        android:layout_height="wrap_content"
        android:text="@string/clubs"
        app:layout_constraintStart_toStartOf="@id/btnClubs"
        app:layout_constraintEnd_toEndOf="@id/btnClubs"
        app:layout_constraintTop_toBottomOf="@id/btnClubs"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Column 4: Support. -->
    <ImageButton
        android:id="@+id/btnSupport"
        style="@style/CampusTopicImage"
        android:contentDescription="@string/support"
        android:src="@drawable/img_btn_support"
        android:onClick="onSupportClick"
        app:layout_constraintWidth_percent="0.21"
        app:layout_constraintStart_toStartOf="@id/columnThreeQuarters"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iconRowTop"
        app:layout_constraintBottom_toTopOf="@id/iconRowBottom" />

    <TextView
        style="@style/CampusTopicCaption"
        android:layout_height="wrap_content"
        android:text="@string/support"
        app:layout_constraintStart_toStartOf="@id/btnSupport"
        app:layout_constraintEnd_toEndOf="@id/btnSupport"
        app:layout_constraintTop_toBottomOf="@id/btnSupport"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>