<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">

    <!-- Column boundaries: outer margins and a central gap. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.035" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnLeftEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.465" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.535" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnRightEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.965" />

    <!-- Vertical positions are proportions of the available content height. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bannerBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/firstRowTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.52" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/firstRowBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.69" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/secondRowTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.77" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/secondRowBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.94" />
    <!-- Green background behind the topic buttons and captions. -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/green"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bannerBottom"
        app:layout_constraintBottom_toBottomOf="parent" />
    <!-- Banner layers: photograph, contrast overlay and welcome text. -->
    <ImageView
        android:id="@+id/bannerImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_main_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bannerBottom" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/banner_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@id/bannerImage"
        app:layout_constraintEnd_toEndOf="@id/bannerImage"
        app:layout_constraintTop_toTopOf="@id/bannerImage"
        app:layout_constraintBottom_toBottomOf="@id/bannerImage" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="@string/welcome_message"
        android:textColor="@color/white"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="@id/bannerImage"
        app:layout_constraintEnd_toEndOf="@id/bannerImage"
        app:layout_constraintTop_toTopOf="@id/bannerImage"
        app:layout_constraintBottom_toBottomOf="@id/bannerImage" />

    <!-- First row. -->
    <ImageButton
        android:id="@+id/btnFacilities"
        style="@style/CampusTopicImage"
        android:contentDescription="@string/facilities"
        android:src="@drawable/img_btn_facilities"
        android:onClick="onFacilitiesClick"
        app:layout_constraintStart_toStartOf="@id/columnLeft"
        app:layout_constraintEnd_toStartOf="@id/columnLeftEnd"
        app:layout_constraintTop_toTopOf="@id/firstRowTop"
        app:layout_constraintBottom_toTopOf="@id/firstRowBottom" />

    <ImageButton
        android:id="@+id/btnEvents"
        style="@style/CampusTopicImage"
        android:contentDescription="@string/events"
        android:src="@drawable/img_btn_events"
        android:onClick="onEventsClick"
        app:layout_constraintStart_toStartOf="@id/columnRight"
        app:layout_constraintEnd_toStartOf="@id/columnRightEnd"
        app:layout_constraintTop_toTopOf="@id/firstRowTop"
        app:layout_constraintBottom_toTopOf="@id/firstRowBottom" />

    <TextView
        style="@style/CampusTopicCaption"
        android:text="@string/facilities"
        app:layout_constraintStart_toStartOf="@id/btnFacilities"
        app:layout_constraintEnd_toEndOf="@id/btnFacilities"
        app:layout_constraintTop_toBottomOf="@id/btnFacilities"
        app:layout_constraintBottom_toTopOf="@id/secondRowTop" />

    <TextView
        style="@style/CampusTopicCaption"
        android:text="@string/events"
        app:layout_constraintStart_toStartOf="@id/btnEvents"
        app:layout_constraintEnd_toEndOf="@id/btnEvents"
        app:layout_constraintTop_toBottomOf="@id/btnEvents"
        app:layout_constraintBottom_toTopOf="@id/secondRowTop" />

    <!-- Second row. -->
    <ImageButton
        android:id="@+id/btnClubs"
        style="@style/CampusTopicImage"
        android:contentDescription="@string/clubs"
        android:src="@drawable/img_btn_clubs"
        android:onClick="onClubsClick"
        app:layout_constraintStart_toStartOf="@id/columnLeft"
        app:layout_constraintEnd_toStartOf="@id/columnLeftEnd"
        app:layout_constraintTop_toTopOf="@id/secondRowTop"
        app:layout_constraintBottom_toTopOf="@id/secondRowBottom" />

    <ImageButton
        android:id="@+id/btnSupport"
        style="@style/CampusTopicImage"
        android:contentDescription="@string/support"
        android:src="@drawable/img_btn_support"
        android:onClick="onSupportClick"
        app:layout_constraintStart_toStartOf="@id/columnRight"
        app:layout_constraintEnd_toStartOf="@id/columnRightEnd"
        app:layout_constraintTop_toTopOf="@id/secondRowTop"
        app:layout_constraintBottom_toTopOf="@id/secondRowBottom" />

    <TextView
        style="@style/CampusTopicCaption"
        android:text="@string/clubs"
        app:layout_constraintStart_toStartOf="@id/btnClubs"
        app:layout_constraintEnd_toEndOf="@id/btnClubs"
        app:layout_constraintTop_toBottomOf="@id/btnClubs"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        style="@style/CampusTopicCaption"
        android:text="@string/support"
        app:layout_constraintStart_toStartOf="@id/btnSupport"
        app:layout_constraintEnd_toEndOf="@id/btnSupport"
        app:layout_constraintTop_toBottomOf="@id/btnSupport"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>