<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Divide each row equally between two topic tiles. -->
    <style name="CampusTopicTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Preserve the icon proportions and fill the available height. -->
    <style name="CampusTopicImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/darker_gray</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Keep all four captions consistent. -->
    <style name="CampusTopicCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Material.Small</item>
    </style>

</resources>